{
 "rule": "hashicorp-tf-password",
 "truePositives": [
  {
   "path": "file.hcl",
   "text": "password       = \"rootpasswd\""
  },
  {
   "path": "file.tf",
   "text": "administrator_login_password = \"thisIsDog11\""
  }
 ],
 "falsePositives": [
  {
   "path": "file.hcl",
   "text": "password = \"${aws_db_instance.default.password}\""
  },
  {
   "path": "file.tf",
   "text": "administrator_login_password = var.db_password"
  },
  {
   "path": "unrelated.js",
   "text": "password       = \"rootpasswd\""
  }
 ]
}
