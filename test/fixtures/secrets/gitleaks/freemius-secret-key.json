{
 "rule": "freemius-secret-key",
 "truePositives": [
  {
   "path": "file.php",
   "text": "$config = array(\n\t\t\t\"secret_key\" => \"sk_ubb4yN3mzqGR2x8#P7r5&@*xC$utE\",\n\t\t);"
  }
 ],
 "falsePositives": [
  {
   "path": "bar.php",
   "text": "$config = array(\n\t\t\t\"secret_key\" => sk_abcdefghijklmnopqrstuvwxyz123,\n\t\t);"
  },
  {
   "path": "baz.php",
   "text": "$config = array(\n\t\t\t\"other_key\" => \"sk_abcdefghijklmnopqrstuvwxyz123\",\n\t\t);"
  },
  {
   "path": "foo.html",
   "text": "$config = array(\n\t\t\t\"secret_key\" => \"sk_ubb4yN3mzqGR2x8#P7r5&@*xC$utE\",\n\t\t);"
  },
  {
   "path": "foo.php",
   "text": "$config = array(\n\t\t\tsecret_key => \"sk_abcdefghijklmnopqrstuvwxyz123\",\n\t\t);"
  }
 ]
}
